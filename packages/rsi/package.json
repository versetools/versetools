{
    "name": "@versetools/rsi",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        "./config/*": {
            "types": "./src/config/*.ts",
            "import": "./src/config/*.ts"
        },
        "./requests/*": {
            "types": "./src/requests/*.ts",
            "import": "./src/requests/*.ts"
        },
        "./services/*": {
            "types": "./src/services/*.ts",
            "import": "./src/services/*.ts"
        }
    },
    "scripts": {
        "check": "tsgo --noEmit",
        "format": "prettier --write .",
        "lint": "eslint . && prettier --check .",
        "lint-fix": "eslint . --fix && prettier --check --write ."
    },
    "packageManager": "pnpm@10.33.2",
    "devDependencies": {
        "@versetools/core": "workspace:*"
    }
}