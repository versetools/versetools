{
    "name": "@versetools/observability",
    "version": "0.2.0",
    "type": "module",
    "author": "l3dotdev",
    "license": "UNLICENSED",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js"
        },
        "./loggers/*": {
            "types": "./build/loggers/*.d.ts",
            "import": "./build/loggers/*.js"
        },
        "./plugins/*": {
            "types": "./build/plugins/*.d.ts",
            "import": "./build/plugins/*.js"
        },
        "./transports/*": {
            "types": "./build/transports/*.d.ts",
            "import": "./build/transports/*.js"
        }
    },
    "files": [
        "build"
    ],
    "scripts": {
        "build": "rm -rf build && tsc -p tsconfig.json",
        "check": "tsc --noEmit",
        "format": "prettier --write .",
        "lint": "eslint . && prettier --check .",
        "lint-fix": "eslint . --fix && prettier --check --write .",
        "package": "pnpm build",
        "prepublishOnly": "pnpm package"
    },
    "dependencies": {
        "@loglayer/plugin": "^3.3.0",
        "@loglayer/transport-tslog": "^4.3.0",
        "serialize-error": "^13.1.0"
    },
    "peerDependencies": {
        "@sveltejs/kit": "^2.0.0 || ^3.0.0",
        "loglayer": "^9.0.0",
        "tslog": "^5.5.0"
    },
    "packageManager": "pnpm@10.33.2"
}