{
    "name": "@versetools/convex-client",
    "version": "0.2.3",
    "type": "module",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js"
        },
        "./svelte": {
            "types": "./build/svelte/index.d.ts",
            "import": "./build/svelte/index.js",
            "svelte": "./build/svelte/index.js"
        }
    },
    "files": [
        "build"
    ],
    "scripts": {
        "build": "rm -rf build && tsc -p tsconfig.json",
        "check": "tsc --noEmit",
        "format": "prettier --write .",
        "lint": "eslint . && prettier --check .",
        "lint-fix": "eslint . --fix && prettier --check --write .",
        "package": "pnpm build",
        "prepublishOnly": "pnpm package"
    },
    "dependencies": {
        "@versetools/core": "workspace:*",
        "convex-svelte": "catalog:convex"
    },
    "devDependencies": {
        "@sveltejs/kit": "catalog:"
    },
    "packageManager": "pnpm@10.33.2"
}