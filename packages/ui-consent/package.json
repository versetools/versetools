{
    "name": "@versetools/ui-consent",
    "description": "Consent svelte component",
    "version": "0.7.1",
    "type": "module",
    "author": "l3dotdev",
    "license": "UNLICENSED",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "vite dev",
        "sync": "svelte-kit sync",
        "build": "svelte-kit sync && svelte-package",
        "package": "pnpm build",
        "prepublishOnly": "pnpm package",
        "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
        "watch": "svelte-kit sync && svelte-package --watch"
    },
    "dependencies": {
        "@lucide/svelte": "^0.554.0",
        "@melt-ui/svelte": "catalog:",
        "tailwind-merge": "catalog:",
        "tailwind-variants": "catalog:"
    },
    "devDependencies": {
        "@floating-ui/dom": "^1.6.13",
        "@sveltejs/package": "^2.5.0",
        "@sveltejs/vite-plugin-svelte": "catalog:vite",
        "@tailwindcss/vite": "catalog:vite",
        "@typescript/native": "catalog:",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "svelte-exmarkdown": "^5.0.2",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:vite"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*"
    ],
    "peerDependencies": {
        "@l3dev-private/consent": "^0.3.1",
        "@l3dev-private/consent-svelte": ">=0.6.2 <1.0.0",
        "@sveltejs/kit": "catalog:",
        "@versetools/ui": ">=0.22.0 <1.0.0",
        "svelte": "^5.0.0",
        "tailwindcss": "^4.0.0"
    },
    "svelte": "./dist/index.js"
}
